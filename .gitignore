# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
venv/
env/
.env/

# IDE
.idea/
.vscode/
*.swp

# Data files (keep structure but ignore large data)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated plots (optional - remove if you want to commit plots)
plots/*.png

# Saved models (usually too large to commit)
models/*.joblib

# Jupyter
.ipynb_checkpoints/
*.ipynb

# pytest
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db
